# Copy to ".env" and adjust. `make` loads it automatically; never commit the real .env.

DATABASE_URL=postgres://ctt:ctt@localhost:5432/ctt

# Calgary Transit feeds (City of Calgary open data; no API key needed)
GTFS_RT_TRIP_UPDATES=https://data.calgary.ca/download/gs4m-mdc2/application%2Foctet-stream
GTFS_STATIC_URL=https://data.calgary.ca/download/npk7-z3bj/application%2Fzip

# How often the collector polls (Go duration, minimum 10s)
POLL_INTERVAL=30s

# Address the API and dashboard listen on
API_ADDR=:8080
